      "units": "mm",
      "required": false,
      "description": "z-coordinate of the device or support location in the specimen geometry coordinate system."
    },
    {
      "name": "orientation",
      "type": "vocab",
      "units": "none",
      "required": false,
      "allowed_values": [
        "x",
        "y",
        "z"
      ],
      "description": "Orientation of the device or support relative to the specimen geometry coordinate system."
    }
  ],
