    {
      "term": "pad_support",
      "display_name": "Pad Support",
      "definition": "Compliant support element used to provide deformable boundary conditions.",
      "category": "support",
      "parameter_schema_status": "defined",
      "description": "Parametrized deformable pad support used to model compliant boundary conditions in experimental setups.",
      "coordinate_system": {
        "reference_frame": "geometry_coordinate_system",
        "description": "All coordinates and dimensions are defined within the right-handed Cartesian coordinate system associated with the specimen geometry."
      },
      "parameters": [
        {
          "name": "depth",
          "type": "number",
          "units": "mm",
          "required": true,
          "description": "Pad dimension measured along the axis defined by the orientation parameter and orthogonal to the contact surface."
        },
        {
          "name": "thickness",
          "type": "number",
          "units": "mm",
          "required": true,
          "description": "Pad thickness measured in-plane to the contact surface."
        },
        {
          "name": "length",
          "type": "number",
          "units": "mm",
          "required": true,
          "description": "Pad dimension measured in-plane to the contact surface."
        },
        {
          "name": "material",
          "type": "string",
          "required": false,
          "description": "Pad material."
        },
        {
          "name": "elastic_modulus",
          "type": "number",
          "units": "MPa",
          "required": true,
          "description": "Elastic modulus of the pad material."
        },
        {
          "name": "yielding_stress",
          "type": "number",
          "units": "MPa",
          "required": false,
          "description": "Yield stress of the pad material."
        },
        {
          "name": "stress_vs_strain_curve",
          "type": "array",
          "required": false,
          "description": "Embedded constitutive stress-strain response of the pad material.",
          "schema": {
            "data_format": [
              "strain",
              "stress"
            ],
            "units": [
              "-",
              "MPa"
            ]
          }
        }
      ],
      "example": {
        "device_id": "DEV0001",
        "source_id": "SRC0001",
        "test_id": "TST0001",
        "device_type": "pad_support",
        "parameters": {
          "x_location_mm": 0.0,
          "y_location_mm": 0.0,
          "z_location_mm": 0.0,
          "orientation": "z",
          "depth": 50.0,
          "thickness": 10.0,
          "length": 100.0,
          "elastic_modulus": 1500.0,
          "yielding_stress": 12.0,
          "stress_vs_strain_curve": [
            [
              0.0,
              0.0
            ],
            [
              0.001,
              2.0
            ],
            [
              0.005,
              8.0
            ],
            [
              0.02,
              12.0
            ]
          ]
        }
      }
