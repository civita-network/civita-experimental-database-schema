      "parameter_schema_status": "not_yet_defined",
      "parameters": []
    },
    {
      "term": "axial_test",
      "display_name": "Axial Test",
      "definition": "General axial loading test performed under uniaxial compression or tension conditions.",
      "category": "generic_test",
      "parameter_schema_status": "defined",
      "coordinate_system": {
        "reference_frame": "geometry_coordinate_system",
        "description": "All loading directions and eccentricities are defined with respect to the right-handed Cartesian coordinate system associated with the specimen geometry."
      },
      "parameters": [
        {
          "name": "eccentricity_mm",
          "type": "number",
          "units": "mm",
          "required": false,
          "description": "Distance between the applied load line and the specimen centroidal axis. Use 0 for nominally concentric loading when reported."
        },
        {
          "name": "end_condition",
          "type": "vocab",
          "units": "none",
          "required": false,
          "allowed_values": [
            "fixed_fixed",
            "pinned_pinned",
            "fixed_pinned",
            "friction_restrained",
            "unrestrained",
            "other",
            "unknown"
          ],
          "description": "End restraint condition applied to the specimen during axial loading."
        }
      ],
      "example": {
        "test_id": "TST0001",
        "source_id": "SRC0001",
        "specimen_id": "SPC0001",
        "test_type": "axial_test",
        "parameters": {
          "eccentricity_mm": 0.0,
          "end_condition": "friction_restrained"
        }
      }
    },
