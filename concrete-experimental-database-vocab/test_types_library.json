{
  "library_name": "test_types",
  "version": "1.0",
  "description": "Controlled registry and parametrization library for experimental test types and standardized testing procedures used in the tests tab of the Concrete Grand Challenge Experimental Database.",
  "field_name": "test_type",
  "naming_convention": "lowercase_underscore_separated",
  "entries": [
    {
      "term": "accelerated_carbonation_test",
      "display_name": "Accelerated Carbonation Test",
      "definition": "Test evaluating carbonation penetration under accelerated environmental exposure conditions.",
